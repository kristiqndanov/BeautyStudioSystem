@{
    ViewData["Title"] = "Server Error";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 70vh;">
    <div class="mb-4">
        <span style="font-size: 8rem; line-height: 1;">💆‍♀️</span>
    </div>
    <h1 class="display-1 fw-bold" style="color: #198754; font-family: 'Playfair Display', serif;">500</h1>
    <h2 class="mb-3" style="font-family: 'Playfair Display', serif;">We Need a Moment</h2>
    <p class="text-muted mb-4" style="max-width: 480px; font-family: 'Poppins', sans-serif;">
        Something went wrong behind the scenes. Our team is already working on it — just like a good treatment, some things take a little time.
    </p>
    <hr style="width: 80px; border: 2px solid #198754; opacity: 1;" />
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4 px-5 py-2" style="border-radius: 30px; font-family: 'Poppins', sans-serif;">
        Back to Home
    </a>
</div>