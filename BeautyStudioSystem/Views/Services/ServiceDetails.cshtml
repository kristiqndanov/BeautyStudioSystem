@model BeautyStudioSystem.ViewModels.ServiceViewModel

@{
    ViewData["Title"] = "Service Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h2 class="card-title">@Model.Name</h2>

                    <p class="fs-4 mb-2">
                        <strong>Price:</strong> @Model.Price.ToString("C")
                    </p>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-controller="Services" asp-action="Index" class="btn btn-secondary">
                            Back to Services
                        </a>

                        <div>
                            <a asp-controller="Services" asp-action="EditService" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                Edit
                            </a>

                            <form asp-controller="Services" asp-action="DeleteService" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            @* Optional: add a detailed reservations list below if you want to show individual reservation info. *@
        </div>
    </div>
</div>