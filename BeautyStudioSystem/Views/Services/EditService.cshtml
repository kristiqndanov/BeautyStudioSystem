@model BeautyStudioSystem.Core.ViewModels.ServiceViewModel
@{
    ViewData["Title"] = "Edit Service";
}
<h2>Edit Service</h2>
<form asp-action="EditService" method="post" class="mt-4">
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Price" class="control-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="DurationMinutes" class="control-label">Duration (minutes)</label>
        <input asp-for="DurationMinutes" class="form-control" type="number" min="1" />
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="ServiceCategoryId" class="control-label">Category</label>
        <select asp-for="ServiceCategoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">-- Select a category --</option>
        </select>
        <span asp-validation-for="ServiceCategoryId" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}