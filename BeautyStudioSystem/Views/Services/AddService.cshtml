@model BeautyStudioSystem.ViewModels.ServiceViewModel

@{
    ViewData["Title"] = "Add Service";
}

<div class="container mt-5">
    <h2 class="mb-4">Add Service</h2>
    <form asp-action="AddService" method="post">
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Add Service</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}

