@{

    ViewData["Title"] = "Contacts";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow" style="max-width: 500px; width: 100%;">


    <!-- Embedded Google Map -->
    <div style="height: 300px; width: 100%;">
        <iframe
            src="https://www.google.com/maps?q=Sofia,Bulgaria&output=embed"
            width="100%"
            height="300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy">
        </iframe>
    </div>

    <div class="card-body">
        <h4 class="card-title text-center mb-4">Beauty Studio</h4>

        <p class="card-text">
            <strong>Address:</strong><br />
            123 Main Street, Sofia, Bulgaria
        </p>

        <p class="card-text">
            <strong>Phone:</strong><br />
            +359 888 123 456
        </p>

        <p class="card-text mb-2">
            <strong>Working Hours:</strong>
        </p>
        <ul class="list-unstyled">
            <li>Mon – Fri: 09:00 – 19:00</li>
            <li>Saturday: 10:00 – 16:00</li>
            <li>Sunday: Closed</li>
        </ul>
    </div>
</div>


</div>
