@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5 mb-5">
    <h1 class="mb-4">Privacy Policy</h1>

    <p>
        Your privacy is important to us. This Privacy Policy explains how we collect,
        use, and protect your personal information when you use our beauty studio website.
    </p>

    <h4 class="mt-4">1. Information We Collect</h4>
    <p>
        When you register or make a reservation, we may collect the following information:
    </p>
    <ul>
        <li>First and last name</li>
        <li>Email address</li>
        <li>Phone number</li>
        <li>Reservation details</li>
    </ul>

    <h4 class="mt-4">2. How We Use Your Information</h4>
    <p>
        We use your information only for the following purposes:
    </p>
    <ul>
        <li>To manage your account</li>
        <li>To process reservations</li>
        <li>To contact you regarding your appointments</li>
        <li>To improve our services</li>
    </ul>

    <h4 class="mt-4">3. Data Protection</h4>
    <p>
        We take appropriate technical and organizational measures to protect your
        personal data from unauthorized access, loss, or misuse.
    </p>

    <h4 class="mt-4">4. Sharing of Information</h4>
    <p>
        We do not sell, trade, or share your personal information with third parties,
        except when required by law or necessary to provide our services.
    </p>

    <h4 class="mt-4">5. Cookies</h4>
    <p>
        Our website may use cookies to keep you logged in and improve your experience.
        These cookies do not store sensitive personal information.
    </p>

    <h4 class="mt-4">6. Your Rights</h4>
    <p>
        You have the right to:
    </p>
    <ul>
        <li>Access the personal data we hold about you</li>
        <li>Request correction of incorrect data</li>
        <li>Request deletion of your account and data</li>
    </ul>

    <h4 class="mt-4">7. Contact Us</h4>
    <p>
        If you have any questions about this Privacy Policy, please contact us:
    </p>
    <ul>
        <li>Email: your@email.com</li>
        <li>Phone: +359 88 123 4567</li>
    </ul>

    <p class="mt-4 text-muted">
        Last updated: @DateTime.Now.ToString("MMMM yyyy")
    </p>
</div>
