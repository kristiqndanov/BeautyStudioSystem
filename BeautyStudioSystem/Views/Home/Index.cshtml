@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="container-fluid p-0">
    <div class="bg-dark text-white text-center d-flex align-items-center justify-content-center"
         style="height: 70vh; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/hero.jpg') center/cover no-repeat;">
        <div>
            <h1 class="display-4 fw-bold">Feel Beautiful. Feel Confident.</h1>
            <p class="lead">
                Professional beauty treatments in a relaxing and welcoming atmosphere.
            </p>
            <a asp-controller="Services" asp-action="Index" class="btn btn-success btn-lg mt-3">
                View Services
            </a>
        </div>
    </div>
</div>

<!-- About Section -->
<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>Where Beauty Meets Care</h2>
        <p class="text-muted">
            At our studio, beauty is more than appearance—it’s confidence and comfort.
        </p>
    </div>

    <div class="row text-center">
        <div class="col-md-3">
            <h5>Professional Staff</h5>
            <p class="text-muted">Experienced and friendly specialists.</p>
        </div>
        <div class="col-md-3">
            <h5>Clean Environment</h5>
            <p class="text-muted">Hygienic and relaxing atmosphere.</p>
        </div>
        <div class="col-md-3">
            <h5>Quality Products</h5>
            <p class="text-muted">Only trusted professional brands.</p>
        </div>
        <div class="col-md-3">
            <h5>Personal Care</h5>
            <p class="text-muted">Treatments tailored to you.</p>
        </div>
    </div>
</div>

<!-- Services Section -->
<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>Our Main Services</h2>
    </div>

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <img src="/images/services/1.png" class="card-img-top" style="height:250px; object-fit:cover;">
                <div class="card-body">
                    <h5 class="card-title">Haircut & Styling</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <img src="/images/services/2.png" class="card-img-top" style="height:250px; object-fit:cover;">
                <div class="card-body">
                    <h5 class="card-title">Manicure</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <img src="/images/services/3.png" class="card-img-top" style="height:250px; object-fit:cover;">
                <div class="card-body">
                    <h5 class="card-title">Facial Treatment</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <a asp-controller="Services" asp-action="Index" class="btn btn-outline-success">
            See All Services
        </a>
    </div>
</div>

<!-- Special Offer Section -->
<div class="container-fluid bg-success text-white text-center py-5 mt-5">
    <h2>New Client?</h2>
    <p class="lead">Enjoy 10% off your first visit!</p>
    <a asp-controller="Services" asp-action="Index" class="btn btn-light btn-lg">
        Book Now
    </a>
</div>

<!-- Testimonials -->
<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>What Our Clients Say</h2>
    </div>

    <div class="row text-center">
        <div class="col-md-6 mb-3">
            <div class="card shadow p-4">
                <p class="mb-1">⭐⭐⭐⭐⭐</p>
                <p>“Very professional and friendly staff. I always leave feeling beautiful!”</p>
                <small class="text-muted">— Maria P.</small>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow p-4">
                <p class="mb-1">⭐⭐⭐⭐⭐</p>
                <p>“The best manicure I’ve had. Clean, relaxing, and perfect results.”</p>
                <small class="text-muted">— Elena G.</small>
            </div>
        </div>
    </div>
</div>

<!-- Contact Section -->
<div class="container-fluid bg-light mt-5 py-4">
    <div class="container text-center">
        <h4>Contact Us</h4>
        <p class="mb-1">📍 Your Studio Address</p>
        <p class="mb-1">📞 +359 88 123 4567</p>
        <p>🕒 Mon–Sat: 9:00 – 19:00</p>
    </div>
</div>
